{
  "name": "credential-status",
  "version": "3.0.4",
  "description": "credential status aggregator for did-jwt",
  "type": "module",
  "source": "src/index.ts",
  "main": "./lib.commonjs/index.js",
  "module": "./lib.esm/index.js",
  "types": "./lib.commonjs/index.d.ts",
  "files": [
    "lib.esm",
    "lib.commonjs",
    "src",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./lib.esm/index.d.ts",
        "default": "./lib.esm/index.js"
      },
      "require": {
        "types": "./lib.commonjs/index.d.ts",
        "default": "./lib.commonjs/index.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "build": "pnpm run build:common && pnpm run build:esm",
    "build:common": "node_modules/@typescript/native/bin/tsc --project tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > lib.commonjs/package.json",
    "build:esm": "node_modules/@typescript/native/bin/tsc",
    "clean": "rimraf lib dist lib.commonjs lib.esm coverage *.tgz",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.[jt]s\"",
    "changeset": "changeset",
    "release:publish": "changeset publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veramolabs/credential-status.git"
  },
  "keywords": [
    "Verifiable Credential",
    "W3C",
    "status check",
    "revocation",
    "credentialStatus",
    "JWT"
  ],
  "author": "Mircea Nistor",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/veramolabs/credential-status/issues"
  },
  "homepage": "https://github.com/veramolabs/credential-status#readme",
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "did-jwt": "^9.0.3",
    "did-resolver": "^6.0.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.18.0"
}
